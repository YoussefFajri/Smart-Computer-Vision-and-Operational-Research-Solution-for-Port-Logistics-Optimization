# ─────────────────────────────────────────────
#  Marsa Maroc — Port Logistics AI Platform
#  Environment Configuration Template
#  Copy this file to '.env' before running!
# ─────────────────────────────────────────────

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# Database — PostgreSQL (Use 'db' service name when inside Docker Compose, or 'localhost' when running backend locally)
DATABASE_URL=postgresql://marsa_user:marsa_password@db:5432/marsa_maroc

# Paths inside container/app
UPLOAD_FOLDER=uploads
STATIC_FOLDER=static
REPORTS_FOLDER=reports

# YOLO Model Configuration
YOLO_MODEL_PATH=model/runs/marsa_container_model/weights/best.pt
YOLO_CONFIDENCE=0.40

# Flask API Base URL (Streamlit -> Backend; use 'http://backend:5000' inside Docker, 'http://localhost:5000' locally)
API_BASE_URL=http://backend:5000

# LLM Assistant (options: template | ollama | groq)
LLM_BACKEND=template
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b
GROQ_API_KEY=your_groq_api_key_here

# Azure Storage (Optional for Cloud Backup)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=container-images

# Apache Kafka Streaming
KAFKA_BROKER_URL=localhost:9094
KAFKA_TOPIC=camera_detections
